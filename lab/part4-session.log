import os, ssl, urllib.request, json
base="/var/run/secrets/kubernetes.io/serviceaccount"
token=open(base+"/token").read().strip()
ctx=ssl.create_default_context(cafile=base+"/ca.crt")
url="https://kubernetes.default.svc/api/v1/namespaces/debug-lab/pods?limit=100"
req=urllib.request.Request(url,headers={"Authorization":"Bearer "+token})
try:
 r=urllib.request.urlopen(req,context=ctx,timeout=10)
 body=r.read()
 print("HTTP:",r.status,"Bytes:",len(body))
