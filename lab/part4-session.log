apiVersion: v1
kind: Service
metadata:
  name: backend
  labels:
    app: backend
    {{- include "lab.labels" . | nindent 4 }}
spec:
  selector:
    app: backend
  ports:
    - name: http
      port: 8080
      targetPort: {{ .Values.common.port }}
